{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "启动后端 (Spring Boot)",
            "request": "launch",
            "mainClass": "assistant.assistant_app",
            "projectName": "assistant", 
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "server.port": "8080"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "启动前端 (Vite)",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}/frontend",
            "serverReadyAction": {
                "pattern": "local",
                "action": "openExternally",
                "uriFormat": "http://localhost:5173/login"
            },
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "全栈一键启动",
            "configurations": [
                "启动后端 (Spring Boot)",
                "启动前端 (Vite)"
            ]
        }
    ]
}